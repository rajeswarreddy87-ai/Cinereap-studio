{
  "name": "cinerecap-render-server",
  "version": "1.0.0",
  "description": "Self-hosted render server for CineRecap Studio: trims, concats, and exports MP4s using FFmpeg.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
