    "fluent-ffmpeg": "^2.1.3",
    "googleapis": "^144.0.0",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^5.0.9",
    "twelvelabs-js": "^1.2.8",
    "undici": "^7.28.0"
  },
  "devDependencies": {
    "eslint": "^10.6.0"
  },
  "engines": {
    "node": ">=20"
  }
